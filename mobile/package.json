{
  "name": "xyz.eremef.beta",
  "productName": "Beta Player",
  "main": "index.js",
  "expo": {
    "install": {
      "exclude": [
        "expo"
      ]
    },
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-volume-manager"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx eas-cli build --platform android",
    "build:locally": "npx eas-cli build --platform android --local --profile production",
    "test": "jest --runInBand",
    "lint": "cd .. && eslint mobile",
    "typecheck": "tsc --noEmit",
    "android:build": "npm run sync-assets && expo run:android",
    "android:build:dev": "cross-env EXPO_DEV_PACKAGE=xyz.eremef.bandcamp.remote.dev npm run android:build",
    "sync-assets": "node ../scripts/create-shared-symlink.js && node ../scripts/generate-config-hash.js && node ../scripts/copy-assets.js",
    "prebuild": "npm run sync-assets",
    "expo:prebuild": "npx expo prebuild --clean -p android",
    "prestart": "npm run sync-assets",
    "postinstall": "node ../scripts/create-shared-symlink.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@preeternal/react-native-cookie-manager": "^6.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@rntp/player": "5.12.1",
    "cheerio": "1.0.0-rc.12",
    "expo": "58.0.17",
    "expo-asset": "~58.0.18",
    "expo-background-fetch": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-modules-core": "~58.0.24",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "js-base64": "^3.7.8",
    "js-md5": "^0.8.3",
    "js-sha256": "^0.11.1",
    "lucide-react-native": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-volume-manager": "^2.2.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "shaka-player": "^4.16.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/js-md5": "^0.8.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "cross-env": "^10.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "metro-config": "~0.84.6",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "js-yaml": "^3.15.0",
    "@expo/xcpretty": {
      "js-yaml": "^4.3.0"
    }
  },
  "private": true
}
