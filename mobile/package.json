{
  "name": "xyz.eremef.beta",
  "productName": "Beta Player",
  "main": "index.js",
  "expo": {
    "install": {
      "exclude": [
        "expo"
      ]
    },
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-volume-manager"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx eas-cli build --platform android",
    "build:locally": "npx eas-cli build --platform android --local --profile production",
    "test": "jest",
    "lint": "cd .. && eslint mobile",
    "typecheck": "tsc --noEmit",
    "android:build": "npm run sync-assets && expo run:android",
    "android:build:dev": "cross-env EXPO_DEV_PACKAGE=xyz.eremef.bandcamp.remote.dev npm run android:build",
    "sync-assets": "node ../scripts/create-shared-symlink.js && node ../scripts/generate-config-hash.js && node ../scripts/copy-assets.js",
    "prebuild": "npm run sync-assets",
    "expo:prebuild": "npx expo prebuild --clean -p android",
    "prestart": "npm run sync-assets",
    "postinstall": "node ../scripts/create-shared-symlink.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@preeternal/react-native-cookie-manager": "^6.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@rntp/player": "^5.9.2",
    "cheerio": "1.0.0-rc.12",
    "expo": "57.0.24",
    "expo-asset": "~57.0.18",
    "expo-background-fetch": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "js-base64": "^3.7.8",
    "js-md5": "^0.8.3",
    "js-sha256": "^0.11.1",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "shaka-player": "^4.16.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/js-md5": "^0.8.0",
    "@types/react": "~19.2.11",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "metro-config": "^0.83.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "js-yaml": "^3.15.0",
    "@expo/xcpretty": {
      "js-yaml": "^4.3.0"
    }
  },
  "private": true
}
