{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "react-native/Libraries/Types/CodegenTypes": [
        "./node_modules/react-native/types_generated/Libraries/Types/CodegenTypes"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  }
}
